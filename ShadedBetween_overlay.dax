// ================================================================
//  SHADED BETWEEN — version OVERLAY (rapide, autonome, sans UDF)
//
//  Dessine la bande entre DEUX séries (Valeur 1 et Valeur 2) et la
//  colore en deux teintes selon laquelle est au-dessus de l'autre.
//
//  Optimisation : aucun calcul de croisement en DAX. On dessine la
//  bande UNE fois, puis on la peint DEUX fois avec du CLIPPING SVG
//  (au-dessus / en-dessous de la Valeur 2) — le moteur de rendu fait
//  le découpage aux croisements gratuitement.
//  -> supprime tous les passages O(N²) (SegWithNext/CrossPoints/Runs).
//  Mesuré : ~1/3 du CPU de la version « merged runs ».
//
//  Les séries ne sont PAS forcément des moyennes mobiles : V1 et V2
//  peuvent être n'importe quelle paire de mesures. La Valeur 2 sert
//  de référence (c'est elle qui décide où c'est vert / rouge).
//
//  ⚠ Catégorie de données de la mesure = ImageUrl (élément Image).
//  Décimation : garde ~_W points (utile si l'axe est quotidien).
// ================================================================


// ================================================================
//  ┌── À CONFIGURER (1/2) : APPARENCE ─────────────────────────────
//  Réglages purement visuels. Édite librement.
// ================================================================

// --- Dimensions du canevas (ratios, PAS des pixels : le visuel
//     étire l'image. Garde un rapport largeur/hauteur ~ ta carte). ---
VAR _W    = 300     // largeur du dessin
VAR _H    = 100     // hauteur du dessin
VAR _Pad  = 5       // marge tout autour (évite que le tracé touche les bords)
VAR _YPad = 0.05    // air vertical = 5 % de l'amplitude (haut et bas)

// --- Remplissage entre les deux lignes ---
//     La frontière vert/rouge est la ligne Valeur 2 (voir bloc 2/2).
VAR _Above  = "#2E7D32"   // couleur quand Valeur 1 est AU-DESSUS de Valeur 2 (vert)
VAR _Below  = "#C62828"   // couleur quand Valeur 1 est EN-DESSOUS de Valeur 2 (rouge)
VAR _FillOp = 0.35        // opacité du remplissage (0 = invisible … 1 = plein)

// --- Ligne Valeur 1 (série principale, trait plein) ---
VAR _V1C = "#1F77B4"      // couleur
VAR _V1W = 3              // épaisseur

// --- Ligne Valeur 2 (série de référence, trait pointillé) ---
//     C'est ELLE qui départage le vert et le rouge.
VAR _V2C = "#555555"      // couleur
VAR _V2W = 2              // épaisseur
//  └──────────────────────────────────────────────────────────────

// Échappement du « # » en « %23 » (obligatoire dans une data-URI SVG,
// sinon le « # » coupe l'URL). Ne pas toucher.
VAR _AboveE = SUBSTITUTE ( _Above, "#", "%23" )
VAR _BelowE = SUBSTITUTE ( _Below, "#", "%23" )
VAR _V1E    = SUBSTITUTE ( _V1C,   "#", "%23" )
VAR _V2E    = SUBSTITUTE ( _V2C,   "#", "%23" )


// ================================================================
//  ┌── À CONFIGURER (2/2) : SÉRIES & AXE ──────────────────────────
//  Le cœur à adapter pour un autre KPI. Trois choses :
//    1. l'AXE X (les catégories, ici un mois par point) ;
//    2. la VALEUR 1 (ligne pleine) ;
//    3. la VALEUR 2 (ligne pointillée = référence vert/rouge).
// ================================================================

// 1. AXE X = catégories de l'axe. Change dim_Date[1 month] pour un
//    autre grain (semaine, jour, trimestre…).
VAR BaseBins = SELECTCOLUMNS ( VALUES ( dim_Date[1 month] ), "BinDate", dim_Date[1 month] )

// Jour d'ancrage de chaque catégorie (dernier jour du mois) : point
// exact où les mesures seront évaluées. Garde MAX ( dim_Date[Date] ).
VAR Bins0 = ADDCOLUMNS ( BaseBins, "AnchorDay", CALCULATE ( MAX ( dim_Date[Date] ) ) )

// 2 & 3. Les DEUX séries à comparer, un point par catégorie.
//    Remplace [Weight MA1] / [Weight MA2] par TES deux mesures
//    (n'importe quelle paire). Le TREATAS force l'évaluation au jour
//    d'ancrage ; KEEPFILTERS garde le contexte du visuel.
VAR BinsV =
    ADDCOLUMNS (
        Bins0,
        "V1", VAR ad = [AnchorDay] RETURN CALCULATE ( [Weight MA1], KEEPFILTERS ( TREATAS ( { ad }, dim_Date[Date] ) ) ),  // <- Valeur 1 (ligne pleine)
        "V2", VAR ad = [AnchorDay] RETURN CALCULATE ( [Weight MA2], KEEPFILTERS ( TREATAS ( { ad }, dim_Date[Date] ) ) )   // <- Valeur 2 (référence, pointillé)
    )

// Ne garde que les points valides (les 3 valeurs présentes).
VAR Valid = FILTER ( BinsV, NOT ISBLANK ( [AnchorDay] ) && NOT ISBLANK ( [V1] ) && NOT ISBLANK ( [V2] ) )
//  └──────────────────────────────────────────────────────────────
//  (au-delà d'ici, plus rien à configurer)


// ---------- ÉCHELLES (mise à l'échelle X et Y du dessin) ----------
VAR XMin = MINX ( Valid, [BinDate] )
VAR XMax = MAXX ( Valid, [BinDate] )
VAR XSpan = IF ( XMax - XMin = 0, 1, XMax - XMin )
VAR YMin = MINX ( Valid, MIN ( [V1], [V2] ) )
VAR YMax = MAXX ( Valid, MAX ( [V1], [V2] ) )
VAR YSpan = IF ( YMax - YMin = 0, 1, YMax - YMin )
VAR YMinP = YMin - YSpan * _YPad
VAR YSpanP = ( YMax + YSpan * _YPad ) - YMinP

// Coordonnées écran de chaque point (Y inversé : 0 = haut).
VAR P0 =
    ADDCOLUMNS (
        Valid,
        "X", _W * DIVIDE ( [BinDate] - XMin, XSpan, 0 ),
        "Y1", _H - ( _H * DIVIDE ( [V1] - YMinP, YSpanP, 0 ) ),
        "Y2", _H - ( _H * DIVIDE ( [V2] - YMinP, YSpanP, 0 ) ),
        "Ord", RANKX ( Valid, [BinDate], , ASC, Dense )
    )

// Décimation : ramène à ~_W points max (garde toujours le dernier),
// pour ne pas générer un SVG géant quand l'axe est très fin.
VAR N = COUNTROWS ( P0 )
VAR Step = IF ( _W > 1, CEILING ( DIVIDE ( N, _W ), 1 ), 1 )
VAR P = FILTER ( P0, MOD ( [Ord] - 1, Step ) = 0 || [Ord] = N )
VAR HasData = COUNTROWS ( P ) > 1

// ---------- CHEMINS (une seule passe chacun, PAS de O(N²)) ----------
VAR V1Fwd = CONCATENATEX ( P, INT ( [X] ) & " " & INT ( [Y1] ), " L ", [Ord], ASC )   // Valeur 1, aller
VAR V2Fwd = CONCATENATEX ( P, INT ( [X] ) & " " & INT ( [Y2] ), " L ", [Ord], ASC )   // Valeur 2, aller
VAR V2Bwd = CONCATENATEX ( P, INT ( [X] ) & " " & INT ( [Y2] ), " L ", [Ord], DESC )  // Valeur 2, retour
// Bande = Valeur 1 (aller) + Valeur 2 (retour), fermée. Auto-intersectée
// aux croisements ; le fill-rule nonzero remplit les deux lobes, le
// clipping fait la couleur.
VAR Band = "M " & V1Fwd & " L " & V2Bwd & " Z"
// Régions de clip, relatives à la Valeur 2 : au-dessus / en-dessous.
VAR TopY = - _H
VAR BotY = 2 * _H
VAR ClipA = "M 0 " & TopY & " L " & _W & " " & TopY & " L " & V2Bwd & " Z"   // au-dessus de V2 -> vert
VAR ClipB = "M 0 " & BotY & " L " & _W & " " & BotY & " L " & V2Bwd & " Z"   // en-dessous de V2 -> rouge

RETURN
    IF (
        NOT HasData,
        BLANK (),
        "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='" & ( - _Pad ) & " " & ( - _Pad ) & " " & ( _W + 2 * _Pad ) & " " & ( _H + 2 * _Pad ) & "'>"
            & "<defs><clipPath id='a'><path d='" & ClipA & "'/></clipPath><clipPath id='b'><path d='" & ClipB & "'/></clipPath></defs>"
            // remplissage vert (clippé au-dessus de V2) puis rouge (en-dessous)
            & "<path d='" & Band & "' fill='" & _AboveE & "' fill-opacity='" & _FillOp & "' clip-path='url(%23a)' stroke='none'/>"
            & "<path d='" & Band & "' fill='" & _BelowE & "' fill-opacity='" & _FillOp & "' clip-path='url(%23b)' stroke='none'/>"
            // ligne Valeur 1 (pleine) puis Valeur 2 (pointillée)
            & "<path d='M " & V1Fwd & "' fill='none' stroke='" & _V1E & "' stroke-width='" & _V1W & "' stroke-linecap='round' stroke-linejoin='round'/>"
            & "<path d='M " & V2Fwd & "' fill='none' stroke='" & _V2E & "' stroke-width='" & _V2W & "' stroke-dasharray='4,4' stroke-linecap='round' stroke-linejoin='round'/>"
            & "</svg>"
    )
