{
  "settings": {
    "sourceTable": "_mesures",
    "sourceFolder": "_indicateurs",
    "dateColumn": "'dim_Date'[Date]",
    "targetTable": "_mesures",
    "displayFolderPattern": "{baseFolder}\\_{variation}",
    "branchFolderPattern": "{baseFolder}\\__{branch}",
    "overwriteExisting": true,
    "removeOrphans": true,
    "dryRun": false
  },
  "fieldParameter": {
    "enabled": true,
    "tableNames": ["P_Indicateurs_parCalcul", "P_Indicateurs_parCalcul_2"],
    "tableNamesByKpi": ["P_Indicateurs_parKPI"],
    "tableNamesKpiBase": ["P_Indicateurs_parCalcul_baseKPI"],
    "kpiLabelLookup": { "table": "TD_Indicateurs", "keyColumn": "mesure", "labelColumn": "libelle_indicateur" },
    "kpiColumn": "Indicateur",
    "calcColumn": "Calcul",
    "branchColumn": "Branche",
    "noBranchLabel": "Réel",
    "includeBase": true,
    "baseLabel": "Réel"
  },
  "switch": {
    "enabled": true,
    "name": "Switch KPI",
    "selector": "'TD_KPI'[mesure]",
    "displayFolder": "_switch",
    "formatString": "#,0.0",
    "dynamicFormat": false
  },
  "branches": {
    "YTD": {}
  },
  "variations": {
    "7d avg": {
      "namePattern": "{base} 7d avg",
      "inFieldParameter": true,
      "dax": [
        "AVERAGEX(",
        "    DATESINPERIOD({date}, MAX({date}), -7, DAY),",
        "    {baseRef}",
        ")"
      ],
      "formatString": "inherit",
      "description": "Moyenne mobile 7 jours de {base}"
    },
    "30d avg": {
      "namePattern": "{base} 30d avg",
      "inFieldParameter": true,
      "dax": [
        "AVERAGEX(",
        "    DATESINPERIOD({date}, MAX({date}), -30, DAY),",
        "    {baseRef}",
        ")"
      ],
      "formatString": "inherit",
      "description": "Moyenne mobile 30 jours de {base}"
    },
    "Δ 7d": {
      "namePattern": "{base} Δ 7d",
      "inFieldParameter": true,
      "dax": [
        "VAR Cur = {baseRef}",
        "VAR Prev = CALCULATE({baseRef}, DATEADD({date}, -7, DAY))",
        "RETURN",
        "    IF(NOT ISBLANK(Cur) && NOT ISBLANK(Prev), (Cur - Prev) * {deltaScale})"
      ],
      "formatString": "delta",
      "description": "Variation de {base} vs 7 jours plus tôt"
    },
    "Δ 30d": {
      "namePattern": "{base} Δ 30d",
      "inFieldParameter": true,
      "dax": [
        "VAR Cur = {baseRef}",
        "VAR Prev = CALCULATE({baseRef}, DATEADD({date}, -30, DAY))",
        "RETURN",
        "    IF(NOT ISBLANK(Cur) && NOT ISBLANK(Prev), (Cur - Prev) * {deltaScale})"
      ],
      "formatString": "delta",
      "description": "Variation de {base} vs 30 jours plus tôt"
    },
    "PY": {
      "namePattern": "{base} PY",
      "inFieldParameter": true,
      "dax": "CALCULATE({baseRef}, SAMEPERIODLASTYEAR({date}))",
      "formatString": "inherit",
      "description": "{base} pour la même période l'année précédente"
    },
    "YoY %": {
      "namePattern": "{base} YoY %",
      "inFieldParameter": true,
      "dax": [
        "VAR Cur = {baseRef}",
        "VAR Prev = CALCULATE({baseRef}, SAMEPERIODLASTYEAR({date}))",
        "RETURN",
        "    DIVIDE(Cur - Prev, Prev)"
      ],
      "formatString": "+#,0.0%;-#,0.0%;#,0.0%",
      "description": "Variation annuelle en % de {base}"
    },
    "YTD": {
      "namePattern": "{base} YTD",
      "inFieldParameter": true,
      "dax": "CALCULATE({baseRef}, DATESYTD({date}))",
      "formatString": "inherit",
      "description": "Cumul annuel de {base}"
    },
    "MTD": {
      "namePattern": "{base} MTD",
      "inFieldParameter": true,
      "dax": "CALCULATE({baseRef}, DATESMTD({date}))",
      "formatString": "inherit",
      "description": "Cumul mensuel de {base}"
    },
    "sparkline": {
      "namePattern": "{base} sparkline",
      "inFieldParameter": false,
      "dataCategory": "ImageUrl",
      "displayFolder": "{baseFolder}\\_SVG",
      "formatString": "inherit",
      "dax": [
        "// Sparkline SVG autonome (aucune UDF). Édite les VAR de réglages.",
        "VAR _W = 150",
        "VAR _H = 40",
        "VAR _Pad = 5",
        "VAR _YPad = 0.05",
        "VAR _Color = \"#1F77B4\"",
        "VAR _LineW = 3",
        "VAR _FillOp = 0.2",
        "VAR _ColorE = SUBSTITUTE ( _Color, \"#\", \"%23\" )",
        "VAR BaseBins = SELECTCOLUMNS ( VALUES ( {date} ), \"BinDate\", {date} )",
        "VAR BinsV = ADDCOLUMNS ( BaseBins, \"V\", VAR ad = [BinDate] RETURN CALCULATE ( {baseRef}, KEEPFILTERS ( TREATAS ( { ad }, {date} ) ) ) )",
        "VAR ValidBins = FILTER ( BinsV, NOT ISBLANK ( [V] ) )",
        "VAR XMinDate = MINX ( ValidBins, [BinDate] )",
        "VAR XMaxDate = MAXX ( ValidBins, [BinDate] )",
        "VAR XSpanSafe = IF ( XMaxDate - XMinDate = 0, 1, XMaxDate - XMinDate )",
        "VAR YMin = MINX ( ValidBins, [V] )",
        "VAR YMax = MAXX ( ValidBins, [V] )",
        "VAR YSpanSafe = IF ( YMax - YMin = 0, 1, YMax - YMin )",
        "VAR YMinPad = YMin - YSpanSafe * _YPad",
        "VAR YSpanPad = ( YMax + YSpanSafe * _YPad ) - YMinPad",
        "VAR P0 = ADDCOLUMNS ( ValidBins, \"X\", _W * DIVIDE ( [BinDate] - XMinDate, XSpanSafe, 0 ), \"Y\", _H - ( _H * DIVIDE ( [V] - YMinPad, YSpanPad, 0 ) ) )",
        "VAR P1 = ADDCOLUMNS ( P0, \"Order\", RANKX ( P0, [BinDate], , ASC, Dense ) )",
        "VAR N = COUNTROWS ( P1 )",
        "VAR Step = IF ( _W > 1, CEILING ( DIVIDE ( N, _W ), 1 ), 1 )",
        "VAR P = FILTER ( P1, MOD ( [Order] - 1, Step ) = 0 || [Order] = N )",
        "VAR HasData = COUNTROWS ( P ) > 1",
        "VAR LinePts = CONCATENATEX ( P, INT ( [X] ) & \" \" & INT ( [Y] ), \" L \", [Order] )",
        "VAR MaxOrd = MAXX ( P, [Order] )",
        "VAR MinOrd = MINX ( P, [Order] )",
        "VAR LastX = MAXX ( FILTER ( P, [Order] = MaxOrd ), [X] )",
        "VAR FirstX = MAXX ( FILTER ( P, [Order] = MinOrd ), [X] )",
        "VAR FillD = \"M \" & LinePts & \" L \" & INT ( LastX ) & \" \" & _H & \" L \" & INT ( FirstX ) & \" \" & _H & \" Z\"",
        "VAR FillTag = IF ( _FillOp = 0, \"\", \"<path d='\" & FillD & \"' fill='\" & _ColorE & \"' fill-opacity='\" & _FillOp & \"' stroke='none' />\" )",
        "VAR LineTag = \"<path d='M \" & LinePts & \"' fill='none' stroke='\" & _ColorE & \"' stroke-width='\" & _LineW & \"' stroke-linecap='round' stroke-linejoin='round' />\"",
        "RETURN IF ( NOT HasData, BLANK (), \"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='\" & ( - _Pad ) & \" \" & ( - _Pad ) & \" \" & ( _W + 2 * _Pad ) & \" \" & ( _H + 2 * _Pad ) & \"'>\" & FillTag & LineTag & \"</svg>\" )"
      ],
      "description": "Sparkline SVG de {base} (carte, catégorie ImageUrl)"
    },
    "CF Δ 30d": {
      "namePattern": "{base} CF Δ 30d",
      "folderVariation": "Δ 30d",
      "displayFolder": "{folder}\\_CF",
      "dax": [
        "VAR D = [{base} Δ 30d]",
        "RETURN",
        "    SWITCH(TRUE(),",
        "        ISBLANK(D), BLANK(),",
        "        D < 0, \"#2E7D32\",",
        "        D > 0, \"#C62828\",",
        "        \"#9E9E9E\"",
        "    )"
      ],
      "formatString": "inherit",
      "description": "Couleur de formatage conditionnel du Δ 30d de {base} (vert si baisse, rouge si hausse)"
    },
    "CF YoY %": {
      "namePattern": "{base} CF YoY %",
      "folderVariation": "YoY %",
      "displayFolder": "{folder}\\_CF",
      "dax": [
        "VAR V = [{base} YoY %]",
        "RETURN",
        "    SWITCH(TRUE(),",
        "        ISBLANK(V), BLANK(),",
        "        V < 0, \"#2E7D32\",",
        "        V > 0, \"#C62828\",",
        "        \"#9E9E9E\"",
        "    )"
      ],
      "formatString": "inherit",
      "description": "Couleur de formatage conditionnel du YoY % de {base} (vert si baisse, rouge si hausse)"
    }
  }
}
